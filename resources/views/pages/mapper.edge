@layouts.main({
  title: 'Projection Mapping',
  entrypoints: ['resources/css/mapper.css', 'resources/js/mapper.js'],
})
  <div id="app" data-mapping-id="{{ mapping ? mapping.id : '' }}">
    <div id="controls">
      <div class="mapping-top">
        <h1>🎥 Projection Mapping</h1>
        <a href="{{ urlFor('mappings') }}" class="lib-link" title="All saved mappings">Mappings</a>
      </div>

      <div class="mapping-box">
        <div class="mapping-name-row">
          <input
            id="mapping-name"
            type="text"
            maxlength="120"
            placeholder="Untitled mapping"
            aria-label="Mapping name"
            autocomplete="off"
          />
          <span id="mapping-dirty" title="Unsaved changes" hidden></span>
        </div>
        <div class="row">
          <button id="save-btn" class="primary" title="Save (Ctrl/⌘ + S)">Save</button>
          <button id="save-as-btn" class="secondary" title="Save a copy (Ctrl/⌘ + Shift + S)">
            Save as…
          </button>
        </div>
        <div class="row">
          <button id="export-btn" title="Download a .pmap projection file">⇩ Export</button>
          <button id="import-btn" title="Open a .pmap projection file">⇧ Import</button>
        </div>
        <input type="file" id="import-input" accept=".pmap,application/zip" hidden />
        <div id="mapping-status" class="info" role="status" aria-live="polite"></div>
      </div>

      <div>
        <h2>Layers</h2>
        <div id="layers-list"></div>
        <button id="add-layer-btn" class="primary" style="width:100%;margin-top:6px">
          + Add Layer
        </button>
      </div>

      <div id="layer-details">
        <h2>Layer details</h2>
        <input
          id="layer-name"
          type="text"
          maxlength="120"
          placeholder="Layer name"
          aria-label="Layer name"
          autocomplete="off"
        />
        <textarea
          id="layer-desc"
          rows="2"
          maxlength="1000"
          placeholder="Description (what this layer covers, notes for the show…)"
          aria-label="Layer description"
        ></textarea>
      </div>

      <div>
        <h2>Layer Source</h2>
        <div class="source-btns">
          <button id="src-file" title="Media library">📁 File</button>
          <button id="src-camera">📷 Camera</button>
          <button id="src-color">🎨 Color</button>
          <button id="src-material" title="Material library (M)">✨ Material</button>
        </div>
        <div class="info" style="margin-top:4px">
          File and Material open a library. Picking an item replaces the selected clip, or adds a new clip at the playhead.
        </div>
      </div>

      <div id="material-settings" hidden>
        <h2>Material settings</h2>
        <div id="material-params"></div>
      </div>

      <div>
        <h2>Shape</h2>
        <div class="row" style="margin-top:6px">
          <button id="reset-btn" class="secondary" title="Reset corners (R)">Reset corners</button>
          <button id="reset-shape-btn" class="secondary" title="Remove added points (Shift+R)">
            Reset shape
          </button>
        </div>
        <div class="info" style="margin-top:4px">
          Drag a layer to move it. Double-click its edge to add a point; double-click or Alt+click a point to remove it.
        </div>
      </div>
      <div class="row">
        <button id="toggle-corners" class="secondary">Points (P)</button>
        <button id="toggle-ui">Panel (H)</button>
      </div>
      <div class="row">
        <button id="fullscreen-btn">Fullscreen (F)</button>
        <button id="toggle-tl">Timeline (T)</button>
      </div>

      <div class="info" style="margin-top:auto">
        <strong>Hotkeys:</strong>
        <div>H — panel | F — fullscreen | R — reset (Shift: shape)</div>
        <div>P — points | 1-9 — layer | Del — delete</div>
        <div>T — timeline | M — materials</div>
        <div>Space — play/pause</div>
        <div>Ctrl/⌘+S — save (Shift: save as)</div>
        <div>←/→ — step (Shift: 1s) | Home/End</div>
      </div>
    </div>

    <aside id="media-panel" class="side-panel" hidden>
      <div class="mat-panel-head">
        <h2>Media</h2>
        <button id="media-close" class="layer-btn" aria-label="Close media">×</button>
      </div>
      <button id="media-upload-btn" class="primary">⇪ Upload videos or images</button>
      <div class="info">
        Or drop files here. Click an item to put it on the selected clip, or add it at the playhead.
      </div>
      <input type="file" id="file-input" accept="video/*,image/*" multiple hidden />
      <div id="media-uploads"></div>
      <div id="media-empty" class="media-empty" hidden>
        Your library is empty. Upload a video or image to get started.
      </div>
      <div id="media-grid" class="tile-grid"></div>
    </aside>

    <aside id="materials-panel" class="side-panel" hidden>
      <div class="mat-panel-head">
        <h2>Materials</h2>
        <button id="materials-close" class="layer-btn" aria-label="Close materials">×</button>
      </div>
      <div class="info">
        Click a material to put it on the selected clip, or add it at the playhead. Hover to preview.
      </div>
      <div id="materials-grid" class="tile-grid"></div>
      <input type="file" id="material-file" accept=".fs,.frag,.glsl,.txt" hidden />
    </aside>

    <div id="mat-editor" hidden>
      <div class="mat-editor-box" role="dialog" aria-labelledby="mat-editor-title">
        <div class="mat-editor-head">
          <h2 id="mat-editor-title">New material</h2>
          <input id="mat-name" type="text" maxlength="120" aria-label="Material name" />
          <button id="mat-close" class="layer-btn" aria-label="Close editor">×</button>
        </div>
        <div class="mat-editor-body">
          <textarea id="mat-source" spellcheck="false" aria-label="Shader code"></textarea>
          <div class="mat-editor-side">
            <canvas id="mat-preview" width="320" height="200"></canvas>
            <pre id="mat-errors" hidden></pre>
            <div class="info">
              Materials use the ISF shader format (isf.video). Settings go in the JSON header's INPUTS (float, long, bool, color, point2D) and show up as controls. Use isf_FragNormCoord (0–1), RENDERSIZE and TIME. Ctrl/⌘+S saves.
            </div>
          </div>
        </div>
        <div class="mat-editor-foot">
          <button id="mat-delete" class="danger" hidden>Delete</button>
          <button id="mat-download">Download .fs</button>
          <span class="tl-spacer"></span>
          <button id="mat-cancel">Cancel</button>
          <button id="mat-save" class="primary">Save to library</button>
        </div>
      </div>
    </div>

    <div id="timeline">
      <div id="tl-transport">
        <button id="tl-start" title="Go to start (Home)">⏮</button>
        <button id="tl-play" title="Play / Pause (Space)">▶</button>
        <button id="tl-end" title="Go to end (End)">⏭</button>
        <span id="tl-time">00:00.00</span>
        <span id="tl-dur">/ 00:00.00</span>
        <button id="tl-loop" class="on" title="Loop playback">⟲ Loop</button>
        <div class="tl-spacer"></div>
        <span class="tl-hint">Drag clips to move · drag edges to trim · Ctrl/⌘+scroll to zoom</span>
        <button id="tl-zoom-out" title="Zoom out">−</button>
        <input type="range" id="tl-zoom" min="0.69" max="5.99" step="0.01" />
        <button id="tl-zoom-in" title="Zoom in">+</button>
      </div>
      <div id="tl-scroll">
        <div id="tl-content">
          <div class="tl-row tl-ruler-row">
            <div class="tl-head"></div>
            <div id="tl-ruler" class="tl-lane"></div>
          </div>
          <div id="tl-tracks"></div>
          <div id="tl-playhead"></div>
        </div>
      </div>
    </div>

    <div id="canvas-wrap">
      <canvas id="gl"></canvas>
      <svg id="shape-overlay" aria-hidden="true"></svg>
      <div class="corner" data-idx="0" data-label="TL"></div>
      <div class="corner" data-idx="1" data-label="TR"></div>
      <div class="corner" data-idx="2" data-label="BR"></div>
      <div class="corner" data-idx="3" data-label="BL"></div>
    </div>
  </div>
@end
